---
import Base from "../layouts/Base.astro";
---

<Base title="Uncharted territory">
  <div class="wrap lost">
    <p class="eyebrow">404</p>
    <h1>Uncharted territory</h1>
    <p>This part of the map hasn't been surveyed yet, or it moved. Try the <a href="/">homepage</a> or the <a href="/notes">notes</a>.</p>
  </div>
</Base>

<style>
  .lost { padding-top: 6rem; max-width: 36rem; }
  h1 { font-size: 3rem; margin: 0.3rem 0 1rem; }
</style>
